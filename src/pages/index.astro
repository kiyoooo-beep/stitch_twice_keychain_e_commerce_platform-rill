<PageLayout title="Home">
  
  <style>
    /* Efek Bintang Bersinar (Sparkle Shape) */
    .sparkle-star {
      background-color: white;
      clip-path: polygon(50% 0%, 61% 35%, 100% 50%, 61% 65%, 50% 100%, 39% 65%, 0% 50%, 39% 35%);
      box-shadow: 0 0 12px 3px rgba(255, 255, 255, 0.9);
    }

    @keyframes sparkle-anim {
      0%, 100% { opacity: 0.2; transform: scale(0.7) rotate(0deg); }
      50% { opacity: 1; transform: scale(1.2) rotate(15deg); }
    }
    .animate-sparkle-1 { animation: sparkle-anim 2s infinite ease-in-out; }
    .animate-sparkle-2 { animation: sparkle-anim 3s infinite ease-in-out 1s; }
    .animate-sparkle-3 { animation: sparkle-anim 2.5s infinite ease-in-out 0.5s; }

    /* Animasi Mengambang (Floating Effect) */
    @keyframes float {
      0%, 100% { transform: translateY(0px) rotate(-3deg); }
      50% { transform: translateY(-12px) rotate(3deg); }
    }
    @keyframes float-delayed {
      0%, 100% { transform: translateY(0px) rotate(3deg); }
      50% { transform: translateY(-15px) rotate(-3deg); }
    }
    .animate-float-left { animation: float 4s infinite ease-in-out; }
    .animate-float-right { animation: float-delayed 4.5s infinite ease-in-out; }

    /* Menyembunyikan Scrollbar untuk Slider */
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>

  <!-- WRAPPER PENJEBOL BATAS (FULL EDGE-TO-EDGE) -->
