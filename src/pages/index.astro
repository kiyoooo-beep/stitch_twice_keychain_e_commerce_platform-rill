<!-- SCRIPT CART & SLIDER LOGIC -->
<script is:inline>
  // Logika Cart
  const buttons = document.querySelectorAll('[data-add-to-cart]');
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const productId = Number(button.getAttribute('data-product-id'));
      const productName = button.getAttribute('data-product-name') || 'Product';
      const productPrice = button.getAttribute('data-product-price') || '$0.00';
      const productImage = button.getAttribute('data-product-image') || '';
      const productVariant = button.getAttribute('data-product-variant') || '';

      // Asumsi fungsi ini tersedia di window/module kamu
      if (window.addToCart) {
         window.addToCart({
          id: productId,
          name: productName,
          price: productPrice,
          image: productImage,
          variant: productVariant,
        });
      }
      
      const originalText = button.innerHTML;
      button.innerHTML = 'Added! 🛍️';
      setTimeout(() => {
        button.innerHTML = originalText;
      }, 1000);
    });
  });

  // Logika Slider
  document.addEventListener('DOMContentLoaded', () => {
    const slider = document.getElementById('product-slider');
    const btnLeft = document.getElementById('slider-btn-left');
    const btnRight = document.getElementById('slider-btn-right');

    if (slider && btnLeft && btnRight) {
      // Besaran scroll: Lebar card (approx 208px) + gap (approx 56px) = 264px
      const scrollAmount = 264; 

      btnLeft.addEventListener('click', () => {
        slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });

      btnRight.addEventListener('click', () => {
        slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }
  });
</script>

