---
import PageLayout from '@/layouts/PageLayout.astro';

// Ambil Data API
const response = await fetch(new URL('/api/about-us', Astro.url));
const aboutData = await response.json();

// Masukkan nama file foto toko/booth kamu yang ada di folder public/ di sini:
const storeImg = "1.png"; 

// Semua foto lokal dari kamu khusus untuk Dokumentasi
const docImages = [
  "/about us 1.jpg",
  "/about us 2.jpg",
  "/about us 3.jpg",
  "/about us 4.jpg",
  "/about us 5.jpg"
];
---

<PageLayout title="About Us - TWICE KEYCHAIN">
  
  <style>
    /* ---------------- TOPPING LUCU (ANIMASI) ---------------- */
    /* Efek Bintang Bersinar */
    .sparkle-star {
      background-color: white;
      clip-path: polygon(50% 0%, 61% 35%, 100% 50%, 61% 65%, 50% 100%, 39% 65%, 0% 50%, 39% 35%);
      box-shadow: 0 0 12px 3px rgba(255, 255, 255, 0.9);
    }

    @keyframes sparkle-anim {
      0%, 100% { opacity: 0.2; transform: scale(0.7) rotate(0deg); }
      50% { opacity: 1; transform: scale(1.2) rotate(15deg); }
    }
    .animate-sparkle-1 { animation: sparkle-anim 2s infinite ease-in-out; }
    .animate-sparkle-2 { animation: sparkle-anim 3s infinite ease-in-out 1s; }
    .animate-sparkle-3 { animation: sparkle-anim 2.5s infinite ease-in-out 0.5s; }

    /* Animasi Mengambang untuk Emoji */
    @keyframes float-cute {
      0%, 100% { transform: translateY(0px) rotate(-5deg); }
      50% { transform: translateY(-15px) rotate(5deg); }
    }
    .animate-float { animation: float-cute 4s infinite ease-in-out; }
    .animate-float-delayed { animation: float-cute 5s infinite ease-in-out 2s; }
    /* -------------------------------------------------------- */

    /* Efek Renda (Lace Divider) */
    .lace-divider {
      width: 100%;
      height: 24px;
      background-image: radial-gradient(circle at 10px 12px, transparent 12px, white 13px);
      background-size: 24px 24px;
      background-repeat: repeat-x;
    }
    
    .lace-divider-pink {
      width: 100%;
      height: 24px;
      background-image: radial-gradient(circle at 10px 12px, transparent 12px, #F46B8D 13px);
      background-size: 24px 24px;
      background-repeat: repeat-x;
      transform: scaleY(-1);
    }
  </style>

  <div class="w-[100vw] relative left-1/2 -translate-x-1/2 overflow-x-hidden font-serif" style="font-family: 'Quicksand', sans-serif;">

    <section class="bg-[#F46B8D] w-full pt-28 pb-20 px-6 md:px-16 text-white relative overflow-hidden">
      
      <!-- === TOPPING LUCU BACKGROUND (Z-0) === -->
      <!-- Bintang-bintang -->
      <div class="absolute top-20 left-[20%] w-6 h-6 sparkle-star z-10 pointer-events-none animate-sparkle-1"></div>
      <div class="absolute bottom-28 left-[45%] w-4 h-4 sparkle-star z-10 pointer-events-none animate-sparkle-2"></div>
      <div class="absolute top-32 right-[15%] w-7 h-7 sparkle-star z-10 pointer-events-none animate-sparkle-3"></div>
      <div class="absolute bottom-16 right-[30%] w-5 h-5 sparkle-star z-10 pointer-events-none animate-sparkle-1"></div>
      
            <div class="max-w-7xl mx-auto flex flex-col-reverse md:flex-row items-center gap-16 relative z-30">
        
        <!-- Area Kiri: Gambar Toko (Single Image Layout) -->
        <div class="w-full md:w-1/2 flex justify-center items-center mt-10 md:mt-0 relative z-20">
          <div class="w-full max-w-md aspect-square bg-[#ffe6ed] rounded-[40px] shadow-[12px_12px_0_0_rgba(255,255,255,0.4)] border-4 border-white overflow-hidden transform hover:-translate-y-2 transition-transform duration-500">
            <img 
              src={storeImg} 
              alt="TWICE KEYCHAIN Store" 
              class="w-full h-full object-cover" 
            />
          </div>
        </div>

        <!-- Area Kanan: Teks -->
        <div class="w-full md:w-1/2 flex flex-col items-center md:items-start text-center md:text-left">
          
          <div class="bg-white/20 border-2 border-white text-white px-6 py-2 rounded-full font-bold text-sm tracking-widest flex items-center gap-2 mb-8 backdrop-blur-sm shadow-sm">
            <span>♡</span> ABOUT {aboutData.storeName} <span>♡</span>
          </div>

          <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold mb-6 leading-tight">
            I create worlds where <br/>
            <span class="italic font-light text-[#ffe6ed]">soft, pretty things</span> <br/>
            feel powerful.
          </h1>

          <p class="text-lg md:text-xl text-white/90 leading-relaxed mb-8 max-w-lg">
            Selamat datang di dunia TWICE KEYCHAIN, tempat di mana <i>'Miracle of Charm'</i> benar-benar nyata! ♡ Kami adalah brand aksesoris <i>handmade</i> lokal yang menyulap akrilik dan clay menjadi koleksi gantungan kunci yang unik dan estetis. Setiap detailnya diciptakan dengan ketelitian ekstra untuk menyebarkan keajaiban dan menemani keseharianmu. ✧
          </p>

          <div class="flex flex-wrap gap-4 justify-center md:justify-start text-sm font-bold text-[#F46B8D]">
            <span class="bg-white px-4 py-1.5 rounded-md shadow-sm">✧ Est. 2026</span>
            <span class="bg-white px-4 py-1.5 rounded-md shadow-sm">♡ Handmade</span>
            <span class="bg-white px-4 py-1.5 rounded-md shadow-sm">❀ CUTTIES</span>
          </div>
        </div>

      </div>
    </section>

    <!-- Transisi Renda (Pink ke Krem) -->
    <div class="lace-divider bg-[#F46B8D]"></div>

    <!-- SECTION 2: CONTACT / INFO (Background Krem) -->
    <section class="bg-[#FFFDF5] w-full py-20 px-6 md:px-16 text-[#2F3E46]">
      <div class="max-w-7xl mx-auto">
        
        <div class="flex items-center gap-4 mb-12 justify-center md:justify-start">
          <span class="text-4xl text-[#F46B8D]">✧</span>
          <h2 class="text-4xl md:text-5xl font-bold italic text-[#F46B8D]">Our Info</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
          
          <div class="bg-[#F46B8D] text-white p-8 rounded-[32px] hover:-translate-y-2 transition-transform duration-300 shadow-xl border-4 border-[#ffe6ed]">
            <h3 class="text-2xl font-bold mb-4 font-serif">Location & Base</h3>
            <p class="text-white/90 leading-relaxed text-lg">
              {aboutData.location}. Kami memproduksi dan mengirimkan setiap pesanan dengan penuh cinta dari sini.
            </p>
          </div>

          <div class="bg-[#F46B8D] text-white p-8 rounded-[32px] hover:-translate-y-2 transition-transform duration-300 shadow-xl border-4 border-[#ffe6ed]">
            <h3 class="text-2xl font-bold mb-4 font-serif">Business Inquiries</h3>
            <p class="text-white/90 leading-relaxed text-lg mb-4">
              Ada pertanyaan terkait kolaborasi atau pesanan massal? Kirimkan pesan melalui email.
            </p>
            <a href={`mailto:${aboutData.contactEmail}`} class="inline-block bg-white text-[#F46B8D] font-bold px-4 py-2 rounded-full text-sm">
              {aboutData.contactEmail}
            </a>
          </div>

          <div class="bg-[#F46B8D] text-white p-8 rounded-[32px] hover:-translate-y-2 transition-transform duration-300 shadow-xl border-4 border-[#ffe6ed]">
            <h3 class="text-2xl font-bold mb-4 font-serif">Chat with Us</h3>
            <p class="text-white/90 leading-relaxed text-lg mb-4">
              Butuh bantuan cepat atau custom order? Bestie bisa langsung menghubungi admin kami.
            </p>
            <a href={`https://wa.me/${aboutData.whatsapp.replace(/[^0-9]/g, '')}`} target="_blank" class="inline-block bg-white text-[#F46B8D] font-bold px-4 py-2 rounded-full text-sm">
              {aboutData.whatsapp}
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- Transisi Renda (Krem ke Pink) -->
    <div class="lace-divider-pink bg-[#FFFDF5]"></div>

    <!-- SECTION 3: DOKUMENTASI MEMBER CLASS (Background Pink) -->
    <section class="bg-[#F46B8D] w-full py-20 px-6 md:px-16 text-white pb-32">
      <div class="max-w-7xl mx-auto">
        
        <div class="flex items-center gap-4 mb-12 justify-center md:justify-start">
          <span class="text-4xl text-[#FFFDF5]">✧</span>
          <h2 class="text-4xl md:text-5xl font-bold italic text-[#FFFDF5]">Dokumentasi Member Class</h2>
        </div>

        <div class="flex flex-wrap justify-center gap-4 md:gap-8">
          
          {docImages.map((img, idx) => (
            <div class="bg-white p-2 md:p-3 rounded-[40px] shadow-lg transform transition-transform hover:-translate-y-4 duration-500 w-[160px] md:w-[220px]">
              <div class="w-full aspect-[9/16] bg-[#ffe6ed] rounded-[32px] overflow-hidden relative">
                <img src={img} alt={`Member Class Documentation ${idx+1}`} class="w-full h-full object-cover" />
                <div class="absolute top-4 left-1/2 -translate-x-1/2 w-1/3 h-1.5 bg-white/50 rounded-full backdrop-blur-md"></div>
              </div>
            </div>
          ))}

        </div>

      </div>
    </section>

  </div>
</PageLayout>