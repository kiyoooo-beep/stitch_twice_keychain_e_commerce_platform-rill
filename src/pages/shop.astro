---
import PageLayout from '@/layouts/PageLayout.astro';
import { getProducts } from '@/lib/products';

const products = await getProducts();
const categories = [...new Set(products.map((product) => product.category))].sort();
---

<PageLayout title="Shop">
  <div class="mb-8">
    <h1 class="font-headline-lg text-headline-lg mb-2">Shop</h1>
    <p class="text-on-surface-variant">Browse our collection of kawaii keychains</p>
  </div>

  <!-- Filter Section -->
  <div class="bg-surface-container-low p-4 sm:p-6 rounded-xl mb-8">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="w-full">
        <label for="product-search" class="font-label-caps text-label-caps text-on-surface-variant mb-1.5 block">Search</label>
        <input
          type="text"
          id="product-search"
          placeholder="Cari nama produk..."
          autocomplete="off"
          class="w-full bg-surface-container border-2 border-transparent focus:border-secondary-container focus:ring-0 rounded-lg p-2.5 sm:p-3 text-sm transition-all outline-none"
        />
      </div>
      <div class="w-full">
        <label class="font-label-caps text-label-caps text-on-surface-variant mb-1.5 block">Category</label>
        <select id="category-filter" class="w-full bg-surface-container border-2 border-transparent focus:border-secondary-container focus:ring-0 rounded-lg p-2.5 sm:p-3 text-sm transition-all outline-none">
          <option value="">All Categories</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </div>
      <div class="w-full">
        <label class="font-label-caps text-label-caps text-on-surface-variant mb-1.5 block">Sort By</label>
        <select id="sort-filter" class="w-full bg-surface-container border-2 border-transparent focus:border-secondary-container focus:ring-0 rounded-lg p-2.5 sm:p-3 text-sm transition-all outline-none">
          <option value="newest">Newest</option>
          <option value="price-asc">Price: Low to High</option>
          <option value="price-desc">Price: High to Low</option>
          <option value="popular">Most Popular</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Products Grid -->
  <div id="products-grid" class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6 mb-12">
    {products.map((product) => (
      <div
        class="product-card min-w-0 bg-surface-container-lowest p-3 sm:p-4 rounded-xl cloud-shadow hover:-translate-y-2 transition-transform sticker-border flex flex-col group"
        data-search={`${product.name} ${product.category} ${product.badge}`.toLowerCase()}
        data-category={product.category}
        data-price={product.price.replace(/[^0-9]/g, '')}
        data-id={product.id}
        data-popular={product.badge === 'POPULAR' || product.badge === 'BESTIE FAV' ? 'true' : 'false'}
      >
        <a href={`/product/${product.id}`} class="relative aspect-square rounded-lg overflow-hidden mb-3 bg-surface-container">
          <img
            alt={product.name}
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
            src={product.image}
          />
          {product.badge && (
            <span class="absolute top-1.5 left-1.5 sm:top-2 sm:left-2 bg-pastel-yellow text-primary px-2 py-0.5 sm:py-1 rounded-full text-[9px] sm:text-[10px] font-bold">
              {product.badge}
            </span>
          )}
        </a>
        <h4 class="font-headline-md text-sm sm:text-base mb-1 line-clamp-2 min-h-[2.5rem] flex items-center">{product.name}</h4>
        <span class="font-price-display text-sm sm:text-base text-primary mb-3 font-bold">{product.price}</span>
        <button
          class="mt-auto w-full py-2 bg-secondary-container text-on-secondary-container rounded-full font-bold text-xs sm:text-sm hover:bg-secondary transition-colors"
          data-add-to-cart
          data-product-id={product.id}
          data-product-name={product.name}
          data-product-price={product.price}
          data-product-image={product.image}
          data-product-variant={product.category}
        >
          Add to Cart
        </button>
      </div>
    ))}
  </div>
  <p id="no-products" class="hidden text-center text-on-surface-variant pb-12" aria-live="polite">
    Produk tidak ditemukan. Coba ubah kata kunci atau filter.
  </p>
</PageLayout>

<script>
  import { addToCart } from '@/scripts/cart.js';

  const buttons = document.querySelectorAll('[data-add-to-cart]');
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const productId = Number(button.getAttribute('data-product-id'));
      const productName = button.getAttribute('data-product-name') || 'Product';
      const productPrice = button.getAttribute('data-product-price') || '$0.00';
      const productImage = button.getAttribute('data-product-image') || '';
      const productVariant = button.getAttribute('data-product-variant') || '';

      addToCart({
        id: productId,
        name: productName,
        price: productPrice,
        image: productImage,
        variant: productVariant,
      });
    });
  });
</script>

<script is:inline>
  (() => {
    const searchInput = document.getElementById('product-search');
    const categoryFilter = document.getElementById('category-filter');
    const sortFilter = document.getElementById('sort-filter');
    const productGrid = document.getElementById('products-grid');
    const noProducts = document.getElementById('no-products');
    const productCards = Array.from(document.querySelectorAll('.product-card'));

    if (!searchInput || !categoryFilter || !sortFilter || !productGrid || !noProducts) return;

    const normalize = (text) => text.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

    const updateProducts = () => {
      const queryTerms = normalize(searchInput.value).trim().split(/\s+/).filter(Boolean);
      const category = categoryFilter.value;
      const sort = sortFilter.value;
      const visibleCards = productCards.filter((card) => {
        const matchesSearch = queryTerms.every((term) => normalize(card.dataset.search || '').includes(term));
        return matchesSearch && (!category || card.dataset.category === category);
      });

      visibleCards.sort((a, b) => {
        const priceA = Number(a.dataset.price || 0);
        const priceB = Number(b.dataset.price || 0);
        if (sort === 'price-asc') return priceA - priceB;
        if (sort === 'price-desc') return priceB - priceA;
        if (sort === 'popular') return Number(b.dataset.popular === 'true') - Number(a.dataset.popular === 'true');
        return Number(b.dataset.id || 0) - Number(a.dataset.id || 0);
      });

      productCards.forEach((card) => card.classList.add('hidden'));
      visibleCards.forEach((card) => {
        card.classList.remove('hidden');
        productGrid.appendChild(card);
      });
      noProducts.classList.toggle('hidden', visibleCards.length > 0);
    };

    searchInput.addEventListener('input', updateProducts);
    categoryFilter.addEventListener('change', updateProducts);
    sortFilter.addEventListener('change', updateProducts);
  })();
</script>

<style>
  .sticker-border {
    border: 2px solid rgba(134, 77, 97, 0.1);
  }

  .cloud-shadow {
    box-shadow: 0 20px 40px rgba(74, 85, 104, 0.08);
  }
</style>
