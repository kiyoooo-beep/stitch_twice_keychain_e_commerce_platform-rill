---
import PageLayout from '@/layouts/PageLayout.astro';
---

<PageLayout title="Your Cart">
  <div class="mb-8">
    <h1 class="font-headline-lg text-headline-lg mb-2">Your Cart</h1>
    <p id="cart-count" class="text-on-surface-variant">You have 0 items</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div id="cart-items" class="lg:col-span-2 space-y-4"></div>

    <div class="lg:col-span-1">
      <div id="cart-summary" class="bg-surface-container-high p-6 rounded-xl cloud-shadow border border-surface-variant/30 sticky top-24"></div>
    </div>
  </div>
</PageLayout>

<script>
  import { getCart, removeFromCart, updateQuantity, syncCartBadge } from '@/scripts/cart.js';

  function formatPrice(value) {
    return Math.round(value).toLocaleString('id-ID', {
      style: 'currency',
      currency: 'IDR',
      maximumFractionDigits: 0,
    });
  }

  function parsePrice(value) {
    return Number(String(value).replace(/\D/g, '')) || 0;
  }

  function renderCart() {
    const cartItems = getCart();
    const itemsContainer = document.getElementById('cart-items');
    const summaryContainer = document.getElementById('cart-summary');
    const countText = document.getElementById('cart-count');

    if (!itemsContainer || !summaryContainer || !countText) return;

    countText.textContent = `You have ${cartItems.length} items`;

    if (cartItems.length === 0) {
      itemsContainer.innerHTML = `
        <div class="bg-surface-container-lowest p-8 rounded-xl cloud-shadow border border-surface-variant/30 text-center">
          <p class="text-on-surface-variant mb-4">Your cart is empty.</p>
          <a href="/shop" class="inline-block bg-primary text-white px-6 py-3 rounded-full font-headline-md">Continue Shopping</a>
        </div>
      `;

      summaryContainer.innerHTML = `
        <h2 class="font-headline-md text-headline-md mb-6">Order Summary</h2>
        <div class="space-y-3 mb-6 pb-6 border-b border-surface-variant/50">
          <div class="flex justify-between">
            <span class="text-on-surface-variant">Subtotal</span>
            <span>Rp0</span>
          </div>
          <div class="flex justify-between">
            <span class="text-on-surface-variant">Shipping</span>
            <span class="text-pastel-green font-bold">FREE</span>
          </div>
          <div class="flex justify-between">
            <span class="text-on-surface-variant">Tax</span>
            <span>Rp0</span>
          </div>
        </div>
        <div class="flex justify-between mb-6">
          <span class="font-headline-md text-headline-md">Total</span>
          <span class="font-price-display text-headline-lg text-primary">Rp0</span>
        </div>
      `;
      syncCartBadge();
      return;
    }

    const subtotal = cartItems.reduce((sum, item) => {
      const numericPrice = parsePrice(item.price);
      return sum + numericPrice * item.quantity;
    }, 0);
    const tax = subtotal * 0.08;
    const total = subtotal + tax;

    itemsContainer.innerHTML = cartItems
      .map((item) => {
        const numericPrice = parsePrice(item.price);
        return `
          <div class="bg-surface-container-lowest p-4 rounded-xl cloud-shadow border border-surface-variant/30 flex gap-4">
            <div class="w-24 h-24 bg-white rounded-lg overflow-hidden shrink-0 border border-surface-variant/30">
              <img alt="${item.name}" class="w-full h-full object-cover" src="${item.image}" />
            </div>
            <div class="flex-1 flex flex-col justify-between">
              <div>
                <h3 class="font-headline-md text-headline-md text-primary">${item.name}</h3>
                <p class="text-sm text-on-surface-variant">${item.variant}</p>
              </div>
              <div class="flex justify-between items-center">
                <span class="font-price-display text-price-display text-secondary">${formatPrice(numericPrice)}</span>
                <div class="flex items-center gap-2">
                  <button class="w-8 h-8 rounded border border-outline-variant flex items-center justify-center hover:bg-surface-container" data-update-quantity="-1" data-product-id="${item.id}">
                    <span class="material-symbols-outlined text-sm">remove</span>
                  </button>
                  <span class="w-8 text-center font-bold">${item.quantity}</span>
                  <button class="w-8 h-8 rounded border border-outline-variant flex items-center justify-center hover:bg-surface-container" data-update-quantity="1" data-product-id="${item.id}">
                    <span class="material-symbols-outlined text-sm">add</span>
                  </button>
                  <button class="w-8 h-8 rounded text-error hover:bg-error-container/20 ml-2" data-remove-product="${item.id}">
                    <span class="material-symbols-outlined text-sm">delete</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        `;
      })
      .join('');

    summaryContainer.innerHTML = `
      <h2 class="font-headline-md text-headline-md mb-6">Order Summary</h2>
      <div class="space-y-3 mb-6 pb-6 border-b border-surface-variant/50">
        <div class="flex justify-between">
          <span class="text-on-surface-variant">Subtotal</span>
          <span>${formatPrice(subtotal)}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-on-surface-variant">Shipping</span>
          <span class="text-pastel-green font-bold">FREE</span>
        </div>
        <div class="flex justify-between">
          <span class="text-on-surface-variant">Tax</span>
          <span>${formatPrice(tax)}</span>
        </div>
      </div>
      <div class="flex justify-between mb-6">
        <span class="font-headline-md text-headline-md">Total</span>
        <span class="font-price-display text-headline-lg text-primary">${formatPrice(total)}</span>
      </div>
      <a href="/shipping" class="block w-full bg-primary text-white text-center py-4 rounded-full font-headline-md hover:bg-on-primary-fixed-variant transition-all active:scale-95 shadow-lg">
        Proceed to Checkout
      </a>
      <a href="/shop" class="block w-full mt-3 border-2 border-primary text-primary text-center py-3 rounded-full font-headline-md hover:bg-primary/5 transition-colors">
        Continue Shopping
      </a>
    `;

    itemsContainer.querySelectorAll('[data-update-quantity]').forEach((button) => {
      button.addEventListener('click', () => {
        const productId = Number(button.getAttribute('data-product-id'));
        const delta = Number(button.getAttribute('data-update-quantity'));
        updateQuantity(productId, delta);
        renderCart();
      });
    });

    itemsContainer.querySelectorAll('[data-remove-product]').forEach((button) => {
      button.addEventListener('click', () => {
        const productId = Number(button.getAttribute('data-remove-product'));
        removeFromCart(productId);
        renderCart();
      });
    });

    syncCartBadge();
  }

  renderCart();
  window.addEventListener('cart:updated', renderCart);
</script>

<style>
  .cloud-shadow {
    box-shadow: 0 20px 40px rgba(74, 85, 104, 0.08);
  }

  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
</style>
