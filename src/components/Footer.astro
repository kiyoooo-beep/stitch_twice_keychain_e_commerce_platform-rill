      </div>
      <div>
        <h4 class="font-label-caps text-label-caps text-on-surface mb-4">Shop</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/shop" class="text-on-surface-variant hover:text-primary transition-colors">All Products</a></li>
          <li><a href="/shop" class="text-on-surface-variant hover:text-primary transition-colors">New Arrivals</a></li>
          <li><a href="/shop" class="text-on-surface-variant hover:text-primary transition-colors">Collections</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-label-caps text-label-caps text-on-surface mb-4">Customer</h4>
        <ul class="space-y-2 text-sm">
