          <li><a href="https://wa.me/6285179932283" target="_blank" class="text-on-surface-variant hover:text-primary transition-colors">WhatsApp</a></li>
        </ul>
      </div>
      
      <!-- BAGIAN FOLLOW US (Tombol Hati Outline) -->
      <div>
        <h4 class="font-label-caps text-label-caps text-on-surface mb-4">Follow Us</h4>
        <div class="flex gap-4">
          
          <!-- Tombol Hati 1 (Instagram / Jempol) -->
          <a href="https://instagram.com/azkrzhri_" target="_blank" class="relative w-12 h-12 flex items-center justify-center hover:scale-110 active:scale-95 transition-transform cursor-pointer" aria-label="Instagram">
            <!-- Background Hati (Hanya Outline Garis Pink) -->
            <svg class="absolute inset-0 w-full h-full text-[#F46B8D]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <!-- Ikon di Tengah Hati (Posisi disesuaikan agar nengah persis) -->
            <span class="material-symbols-outlined relative z-10 text-[#F46B8D] text-[18px] -translate-y-[2px]">thumb_up</span>
          </a>

          <!-- Tombol Hati 2 (Favorite) -->
          <a href="#" class="relative w-12 h-12 flex items-center justify-center hover:scale-110 active:scale-95 transition-transform cursor-pointer" aria-label="Favorite">
            <!-- Background Hati (Hanya Outline Garis Pink) -->
            <svg class="absolute inset-0 w-full h-full text-[#F46B8D]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <!-- Ikon di Tengah Hati (Posisi disesuaikan agar nengah persis) -->
            <span class="material-symbols-outlined relative z-10 text-[#F46B8D] text-[18px] -translate-y-[2px]">favorite</span>
          </a>

        </div>
      </div>
      
    </div>
    <div class="border-t border-surface-variant/30 pt-8 text-center text-sm text-on-surface-variant">
      <p>&copy; 2026 TWICE KEYCHAIN. All rights reserved.</p>
    </div>
  </div>
</footer>

<!-- MODAL POPUP UNTUK MENAMPILKAN DATA DARI BACKEND -->
<div id="info-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
  <div class="bg-[#FFFDF5] border-4 border-[#F46B8D] rounded-3xl p-6 md:p-8 max-w-md w-full shadow-2xl relative">
    <button id="close-modal" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-[#F46B8D] text-white font-bold flex items-center justify-center hover:scale-110 transition-transform cursor-pointer">✕</button>
    <h3 id="modal-title" class="font-serif text-2xl font-bold text-[#2F3E46] mb-4"></h3>
    <p id="modal-content" class="text-[#2F3E46] leading-relaxed text-sm md:text-base mb-6 whitespace-pre-line"></p>
    <a id="modal-action-btn" href="#" target="_blank" class="hidden w-full py-3 bg-[#F46B8D] text-white rounded-full font-bold text-center block shadow-md hover:bg-[#d85575] transition-all">Buka di Google Maps 🗺️</a>
  </div>
</div>

<script>
  const modal = document.getElementById('info-modal');
  const modalTitle = document.getElementById('modal-title');
  const modalContent = document.getElementById('modal-content');
  const modalActionBtn = document.getElementById('modal-action-btn');
  const closeModal = document.getElementById('close-modal');

  async function fetchStoreData(type) {
    try {
      const res = await fetch('/api/store-info');
      const data = await res.json();
      
      if (type === 'about') {
        modalTitle.innerText = 'About Us ✨';
        modalContent.innerText = data.aboutUs;
        modalActionBtn.classList.add('hidden');
      } else if (type === 'location') {
        modalTitle.innerText = 'Store Location 📍';
        modalContent.innerText = `Kunjungi workshop kami di:\n\n${data.location.address}`;
        modalActionBtn.href = data.location.mapsLink;
        modalActionBtn.classList.remove('hidden');
      }
      modal.classList.remove('hidden');
    } catch (err) {
      alert('Gagal mengambil data dari server backend.');
    }
  }

  document.getElementById('btn-about')?.addEventListener('click', () => fetchStoreData('about'));
  document.getElementById('btn-location')?.addEventListener('click', () => fetchStoreData('location'));
  closeModal?.addEventListener('click', () => modal.classList.add('hidden'));
  window.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });
</script>