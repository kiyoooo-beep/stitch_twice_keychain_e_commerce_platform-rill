PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Gunakan Publishable key atau legacy anon key dari Supabase Dashboard > Settings > API.
# Jangan pernah isi dengan sb_secret_... atau service_role key, karena variabel PUBLIC_ dikirim ke browser.
PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
