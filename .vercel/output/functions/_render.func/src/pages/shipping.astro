---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Shipping">
  <header class="sticky top-0 z-50 bg-surface/80 backdrop-blur-md h-16 flex items-center px-margin-mobile md:px-margin-desktop justify-between">
    <a href="/cart" class="p-2 rounded-full hover:bg-primary-container/20 transition-all active:scale-95" aria-label="Back to cart"><span class="material-symbols-outlined text-primary">arrow_back</span></a>
    <h1 class="font-headline-lg-mobile text-headline-lg-mobile text-primary tracking-tight">TWICE KEYCHAIN</h1><div class="w-10"></div>
  </header>
  <main class="max-w-2xl mx-auto px-margin-mobile md:px-margin-desktop py-8">
    <div class="flex items-center gap-4 mb-2" aria-label="Checkout progress">
      <div class="flex items-center gap-2"><span class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center font-bold text-sm">1</span><span class="font-headline-md text-headline-md text-primary">Shipping</span></div>
      <div class="h-px flex-1 bg-outline-variant"></div>
      <div class="flex items-center gap-2 opacity-40"><span class="w-8 h-8 rounded-full bg-surface-variant text-on-surface-variant flex items-center justify-center font-bold text-sm">2</span><span class="font-headline-md text-headline-md">Payment</span></div>
    </div>
    <p class="text-sm text-on-surface-variant mb-6" id="shipping-notice" role="status" aria-live="polite">Langkah 1 dari 2: lengkapi data pengiriman.</p>
    <section class="overflow-hidden bg-surface-container-lowest rounded-2xl cloud-shadow border border-surface-variant/50">
      <div class="p-6 md:p-8 bg-primary-container/25 border-b border-primary/10">
        <div class="flex items-center gap-3">
          <span class="w-11 h-11 rounded-full bg-primary text-white flex items-center justify-center material-symbols-outlined">local_shipping</span>
          <div><h2 class="font-headline-md text-headline-md">Data Penerima</h2><p class="text-sm text-on-surface-variant mt-1">Informasi ini akan disimpan pada data pelanggan.</p></div>
        </div>
      </div>
      <form id="shipping-form" class="p-6 md:p-8 space-y-5">
        <label class="space-y-2 block"><span class="font-label-caps text-label-caps text-on-surface-variant ml-1">NAMA LENGKAP</span><input name="nama" required autocomplete="name" placeholder="Masukkan nama penerima" class="w-full bg-surface-container border-2 border-transparent focus:border-primary rounded-xl p-3.5 outline-none transition-colors" /></label>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <label class="space-y-2"><span class="font-label-caps text-label-caps text-on-surface-variant ml-1">EMAIL</span><input name="email" type="email" required autocomplete="email" placeholder="nama@email.com" class="w-full bg-surface-container border-2 border-transparent focus:border-primary rounded-xl p-3.5 outline-none transition-colors" /></label>
          <label class="space-y-2"><span class="font-label-caps text-label-caps text-on-surface-variant ml-1">NOMOR TELEPON</span><input name="telepon" type="tel" required autocomplete="tel" inputmode="tel" placeholder="08xxxxxxxxxx" class="w-full bg-surface-container border-2 border-transparent focus:border-primary rounded-xl p-3.5 outline-none transition-colors" /></label>
        </div>
        <label class="space-y-2 block"><span class="font-label-caps text-label-caps text-on-surface-variant ml-1">ALAMAT LENGKAP</span><textarea name="alamat" required autocomplete="street-address" rows="3" placeholder="Nama jalan, nomor rumah, RT/RW, kelurahan, kecamatan, kota/kabupaten" class="w-full resize-y bg-surface-container border-2 border-transparent focus:border-primary rounded-xl p-3.5 outline-none transition-colors"></textarea></label>
        <label class="space-y-2 block md:max-w-xs"><span class="font-label-caps text-label-caps text-on-surface-variant ml-1">KODE POS</span><input name="kodePos" required autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" placeholder="Contoh: 12345" class="w-full bg-surface-container border-2 border-transparent focus:border-primary rounded-xl p-3.5 outline-none transition-colors" /></label>
        <button id="shipping-submit" type="submit" class="w-full bg-primary text-white py-4 rounded-full font-headline-md flex items-center justify-center gap-2 hover:bg-on-primary-fixed-variant disabled:opacity-60 transition-all active:scale-[.98]">Simpan &amp; Lanjut Pembayaran <span class="material-symbols-outlined">chevron_right</span></button>
      </form>
    </section>
  </main>
</BaseLayout>

<script>
  import { getCart } from '@/scripts/cart.js';

  const form = document.getElementById('shipping-form');
  const notice = document.getElementById('shipping-notice');
  const submitButton = document.getElementById('shipping-submit');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    
    const data = new FormData(form);
    const items = getCart();
    
    if (!items.length) {
      notice.textContent = 'Keranjang kosong. Silakan tambah produk dulu.';
      return;
    }

    const subtotal = items.reduce((sum, item) => sum + (Number(String(item.price).replace(/\D/g, '')) || 0) * item.quantity, 0);
    
    // 1. Generate Order Code Unik yang Fresh (Solusi atasi Error 400!)
    const newOrderCode = 'TWICE-' + Date.now().toString().slice(-5) + Math.floor(Math.random() * 100);

    // 2. Susun Data Sesuai Kolom Database Supabase Kamu
    const shippingData = {
      order_code: newOrderCode,
      nama: data.get('nama'),
      email: data.get('email'),
      alamat: data.get('alamat'),
      telepon: data.get('telepon'),
      kode_pos: data.get('kodePos'),
      pesanan: items, 
      total: subtotal,
      payment_status: 'unpaid',
      status: 'pending'
    };

    submitButton.disabled = true;
    notice.textContent = 'Menyimpan data pesanan...';

    try {
      // 3. Tembak Langsung ke Supabase (By-pass API yang tertimpa tadi)
      const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
      const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

      const res = await fetch(`${supabaseUrl}/rest/v1/pelanggan`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': supabaseKey,
          'Authorization': `Bearer ${supabaseKey}`,
          'Prefer': 'return=minimal'
        },
        body: JSON.stringify(shippingData)
      });

      if (!res.ok) {
        const errText = await res.text();
        throw new Error('Gagal simpan ke database: ' + errText);
      }

      // 4. Simpan ke Session Storage biar bisa dibaca di halaman Checkout
      window.sessionStorage.setItem('twice-shipping-data', JSON.stringify(shippingData));
      
      // 5. EKSEKUSI PINDAH HALAMAN! 🚀
      window.location.href = '/checkout';

    } catch (error) {
      console.error(error);
      notice.textContent = 'Waduh, gagal menyimpan pesanan. Coba klik lagi.';
      submitButton.disabled = false;
    }
  });
</script>