{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image$",
			"dest": "_render"
		},
		{
			"src": "^\\/about\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/pesanan\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/about-us\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/checkout\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/confirm-payment\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/join-member\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/order-status\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/orders\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/resend\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/store-info\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/cart\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/checkout\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/product\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/shipping\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/shop\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/$",
			"dest": "_render"
		}
	]
}